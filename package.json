{
  "name": "zdp-client-sdks",
  "version": "0.16.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Generated TypeScript models and typed client runtime for ZDP API contracts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0disoft/zdp-client-sdks.git"
  },
  "bugs": {
    "url": "https://github.com/0disoft/zdp-client-sdks/issues"
  },
  "homepage": "https://github.com/0disoft/zdp-client-sdks#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./typed-fetch": {
      "types": "./dist/typed-fetch/index.d.ts",
      "import": "./dist/typed-fetch/index.js",
      "default": "./dist/typed-fetch/index.js"
    },
    "./typed-fetch/api-operations": {
      "types": "./dist/typed-fetch/api-operations.d.ts",
      "import": "./dist/typed-fetch/api-operations.js",
      "default": "./dist/typed-fetch/api-operations.js"
    },
    "./upload": {
      "types": "./dist/upload/index.d.ts",
      "import": "./dist/upload/index.js",
      "default": "./dist/upload/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "contracts/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "BOUNDARY.md",
    "RUNBOOK.md",
    "service.yaml",
    "SECURITY.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun scripts/build-package.ts",
    "check": "tsc --noEmit && bun test && bun run contracts:check && bun run api-contracts-lock:check && bun run api-operations:check && bun run typescript-models:check && bun run generation:plan -- --check && bun run release:artifact:check",
    "check:tsgo": "tsgo --noEmit",
    "test": "bun test",
    "contracts:check": "bun scripts/check-client-sdk-contracts.ts",
    "generation:plan": "bun scripts/plan-sdk-generation.ts --api-contracts-root ../zdp-api-contracts",
    "api-contracts-lock:check": "bun scripts/check-api-contracts-lock.ts",
    "api-operations:sync": "bun scripts/sync-api-operations.ts --api-contracts-root ../zdp-api-contracts",
    "api-operations:check": "bun scripts/sync-api-operations.ts --api-contracts-root ../zdp-api-contracts --check",
    "typescript-models:sync": "bun scripts/sync-typescript-api-models.ts --api-contracts-root ../zdp-api-contracts",
    "typescript-models:check": "bun scripts/sync-typescript-api-models.ts --api-contracts-root ../zdp-api-contracts --check",
    "release:artifact:check": "bun run build && bun scripts/build-release-artifact.ts --check",
    "release:check": "tsc --noEmit && bun test tests/release-workflow.test.ts && bun run api-contracts-lock:check && bun run typescript-models:check && bun run release:artifact:check && bun run smoke:package",
    "smoke:package": "bun run build && bun scripts/smoke-packed-package.ts",
    "smoke:vite": "bun run build && bun scripts/smoke-packed-package.ts --vite",
    "smoke:published": "bun scripts/smoke-published-package.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "7.0.0-dev.20260603.1",
    "typescript": "^6.0.3"
  }
}
